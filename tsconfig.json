{

  "compilerOptions": {

    "module": "commonjs",

    "esModuleInterop": true,

    "isolatedModules": true,

    "declaration": true,

    "removeComments": true,

    "emitDecoratorMetadata": true,

    "experimentalDecorators": true,

    "allowSyntheticDefaultImports": true,

    "types": ["node", "jest"],

    "target": "ES2023",

    "sourceMap": true,

    "outDir": "./dist",

    "incremental": true,

    "skipLibCheck": true,

    "strict": true,

    "forceConsistentCasingInFileNames": true

  }

}